#!/usr/bin/env bash
# Pull the latest Garmin data into the nanoclaw agent's group folder.
#
# Re-fetches the last few days AND today. garmin-health-data's --end-date is
# exclusive, so we set it to tomorrow to capture today's activities. The extract
# is an idempotent upsert, so re-running is always safe.
#
# Paths below are filled in by setup/garmin/install.sh at install time.
set -euo pipefail

VENV="__VENV__"
DB="__GROUP_DIR__/garmin_data.db"

LOOKBACK_DAYS="${1:-3}"
START_DATE="$(date -d "-${LOOKBACK_DAYS} days" +%F)"
END_DATE="$(date -d "+1 day" +%F)"

echo "Syncing ${START_DATE} .. ${END_DATE} (end exclusive) -> ${DB}"
exec "${VENV}/bin/garmin" extract \
  --db-path "${DB}" \
  --start-date "${START_DATE}" \
  --end-date "${END_DATE}"

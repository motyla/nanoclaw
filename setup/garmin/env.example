# Garmin health data — add these to .env (which is gitignored)

# Garmin Connect credentials
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Target nanoclaw agent group (from: ncl groups list)
NANOCLAW_GROUP_FOLDER=   # e.g. myhealthbot
NANOCLAW_GROUP_ID=       # e.g. ag-1234567890-abc123 (optional — used to pin model)

# Model to use for the agent (default: haiku, cheapest option)
MODEL=haiku
